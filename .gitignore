# ============================================
# CRM Rise - Git Ignore
# ============================================

# --- Node Modules (ambos backend e frontend) ---
node_modules/
.pnp
.pnp.js

# --- Next.js ---
.next/
out/
build/
dist/

# --- SQLite (persistido via Docker volume) ---
*.db
*.db-journal
*.db-shm
*.db-wal

# --- WhatsApp Sessions (regenerado via QR Code) ---
.wwebjs_auth/
.wwebjs_cache/

# --- Uploads de Mídia (persistido via Docker volume) ---
risein-crm/backend/uploads/

# --- Variáveis de ambiente ---
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local

# --- Logs ---
startup_error.log
dev_log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Scripts temporários ---
risein-crm/backend/api_test.js
risein-crm/backend/check_*.js
risein-crm/backend/list-*.js

# --- TypeScript build cache ---
*.tsbuildinfo

# --- OS / Editor ---
.DS_Store
desktop.ini
Thumbs.db

# --- Agent files (não vai para produção) ---
.agent/
.agents/
